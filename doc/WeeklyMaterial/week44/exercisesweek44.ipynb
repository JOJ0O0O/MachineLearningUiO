    "for fold in range(train_mse.shape[1]):\n",
    "    ax[0].plot(hidden_layer_sizes, train_mse[:, fold], color=\"C0\", alpha=0.25)\n",
    "    ax[1].plot(hidden_layer_sizes, val_mse[:, fold], color=\"C1\", alpha=0.25)\n",
    "\n",
    "ax[0].plot(hidden_layer_sizes, train_mse.mean(axis=1), color=\"C0\", marker=\"o\")\n",
    "ax[1].plot(hidden_layer_sizes, val_mse.mean(axis=1), color=\"C1\", marker=\"o\")\n",
    "\n",
    "ax[0].set_title(\"Training MSE\")\n",
    "ax[1].set_title(\"Validation MSE\")\n",
    "for a in ax:\n",
    "    a.set_xlabel(\"Network size\")\n",
    "    a.set_ylabel(\"MSE\")\n",
    "    a.set_yscale(\"log\")\n",
    "    a.set_xscale(\"log\")\n",
    "\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
