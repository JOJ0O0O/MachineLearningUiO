    "# the data of Project 2, part b)\n",
    "def runge(x):\n",
    "    return 1.0 / (1.0 + 25.0 * x**2)\n",
    "\n",
    "rng = np.random.default_rng(2026)\n",
    "n = 100\n",
    "x = np.sort(rng.uniform(-1.0, 1.0, n))\n",
    "sigma = 0.1\n",
    "y = runge(x) + rng.normal(0.0, sigma, n)\n",
    "X = x.reshape(-1, 1)"
   ]
